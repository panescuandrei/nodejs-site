<h2>Pagina Principală</h2>

<div class="result-container">
    <% if (typeof utilizatorSesiune !== 'undefined' && utilizatorSesiune) { %>
        <p>Bine ai venit, <strong><%= utilizatorSesiune.nume %></strong>! Ești gata să explorezi produsele noastre?</p>
        <a href="/chestionar">Completează Chestionarul</a>
    <% } else { %>
        <p>Nu ești autentificat.</p>
        <a href="/autentificare">Mergi la Autentificare</a>
    <% } %>

    <hr style="margin: 20px 0;">
    
    <div class="db-actions">
        <a href="/creare-bd" style="padding: 10px; background-color: #4CAF50; color: white; text-decoration: none; border-radius: 5px; margin-right: 10px;">Creare BD</a>
        <a href="/inserare-bd" style="padding: 10px; background-color: #008CBA; color: white; text-decoration: none; border-radius: 5px;">Încarcare BD</a>
    </div>

</div>