<h2>Pagina Principală</h2>

<div class="result-container">
    <% if (typeof utilizatorSesiune !== 'undefined' && utilizatorSesiune) { %>
        <p>Bine ai venit, <strong><%= utilizatorSesiune.nume %></strong>! Ești gata să explorezi produsele noastre?</p>
        <a href="/chestionar">Completează Chestionarul</a>
    <% } else { %>
        <p>Nu ești autentificat.</p>
        <a href="/autentificare">Mergi la Autentificare</a>
    <% } %>

    <hr style="margin: 20px 0;">
    
    <div class="db-actions">
        <a href="/creare-bd" class="btn-creare">Creare BD</a>
        <a href="/inserare-bd" class="btn-incarcare">Încarcare BD</a>
    </div>


    <h3>Produse Disponibile</h3>
    
    <% if (typeof produse !== 'undefined' && produse.length > 0) { %>
        <ul class="product-list">
            <% produse.forEach(function(produs) { %>
                <li class="product-item">
                    <div class="product-info">
                        <strong><%= produs.nume %></strong> - <%= produs.pret %> RON <br>
                        <span class="product-category"><%= produs.categorie %></span>
                    </div>
                    
                    <% if (typeof utilizatorSesiune !== 'undefined' && utilizatorSesiune) { %>
                        <form action="/adaugare-cos" method="POST" class="add-to-cart-form">
                            <input type="hidden" name="id" value="<%= produs.id %>">
                            <button type="submit" class="btn-adaugare">Adaugă în coș</button>
                        </form>
                    <% } %>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>Nu există produse în baza de date. Apasă pe "Încarcare BD" pentru a le adăuga.</p>
    <% } %>





</div>