<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produse Cosmetice</title>
    <link rel="stylesheet" href="/stil.css">
</head>
<body>
    <header>
        <h1>Magazin Produse Cosmetice</h1>
        
        <% if (typeof utilizatorSesiune !== 'undefined' && utilizatorSesiune) { %>
            <div style="margin-top: 10px; font-size: 0.9em;">
                <span>Autentificat ca <strong><%= utilizatorSesiune.utilizator %></strong> 
                    (<%= utilizatorSesiune.nume %> <%= utilizatorSesiune.prenume %>)</span>

                <a href="/vizualizare-cos" style="margin-left: 20px; color: white; text-decoration: underline; font-weight: bold;">Coșul Meu</a>
                
                <a href="/delogare" style="margin-left: 15px; color: white; text-decoration: underline;">De-logare</a>
            </div>
        <% } %>
    </header>

    <main>
        <%- body %>
    </main>

</body>
</html>